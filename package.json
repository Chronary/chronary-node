{
  "name": "@chronary/sdk",
  "version": "0.4.0",
  "description": "Official TypeScript SDK for the Chronary calendar-as-a-service API",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chronary",
    "calendar-api",
    "ai-agent",
    "scheduling",
    "calendar-as-a-service",
    "typescript",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chronary/chronary-node"
  },
  "homepage": "https://chronary.ai",
  "bugs": {
    "url": "https://github.com/Chronary/chronary-node/issues"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
